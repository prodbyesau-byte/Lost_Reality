; Haunted Dimension — cumulative Milestone 1 foundation.
config_version=5

[application]
config/name="Haunted Dimension"
run/main_scene="res://core/game.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/description="An original isometric 3D RPG foundation."

[autoload]
DisplayPolicy="*res://core/display/display_policy.gd"
EventBus="*res://core/events/event_bus.gd"
GameState="*res://core/state/game_state.gd"
SceneRouter="*res://core/scene_management/scene_router.gd"
SaveManager="*res://core/save/save_manager.gd"
Progression="*res://core/progression/progression.gd"
VisualQuality="*res://art/presentation/visual_quality.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=2048
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.065, 1)

[physics]
common/physics_ticks_per_second=60

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
